# Copy to .env and adjust for your environment.
# Not committed to git (see .gitignore).

# Postgres connection used for prediction logging.
# Local default (no infra needed): sqlite:///./artifacts/predictions.db
DATABASE_URL=postgresql://mluser:mlpassword@localhost:5432/credit_risk

# MLflow tracking server. Local default: file:./mlruns
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=credit-risk-default-prediction
